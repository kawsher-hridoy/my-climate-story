# Local development only. Change database credentials before exposing a server.
# Leave blank to construct the URL safely from these components. An explicit
# DATABASE_URL overrides components for native development/tests only.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=climate
POSTGRES_PASSWORD=climate_dev_password
POSTGRES_DB=climate
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_ASSET_BASE_URL=/media
APP_CONTACT_URL=http://localhost:5173/about
# NASA Earthdata is required to ingest IMERG measurements. Enter these locally.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
# Optional S3-compatible artifact publication/backup. Local storage works without it.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
SITE_ADDRESS=:80
# Linux build default. Set to default on Docker Desktop if host networking is unavailable.
BUILD_NETWORK=host
# Dedicated Caddy-to-API network. Change all three together if this subnet conflicts.
PROXY_SUBNET=172.30.249.0/29
PROXY_IP=172.30.249.2
PROXY_API_IP=172.30.249.3
