  "components": {
    "schemas": {
      "ActionCard": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "audience": {
            "type": "string",
            "enum": [
              "student",
              "family",
              "school"
            ],
            "title": "Audience"
          },
          "title": {
            "$ref": "#/components/schemas/Localized"
          },
          "description": {
            "$ref": "#/components/schemas/Localized"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tags",
          "audience",
          "title",
          "description",
          "source_url"
        ],
        "title": "ActionCard"
      },
      "AnnualObservation": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "year",
          "value"
        ],
        "title": "AnnualObservation"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError"
      },
      "ClimateComponent": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "publication_state": {
            "$ref": "#/components/schemas/PublicationState"
          },
          "source": {
            "$ref": "#/components/schemas/SourceMetadata"
          },
          "annual": {
            "items": {
              "$ref": "#/components/schemas/AnnualObservation"
            },
            "type": "array",
            "title": "Annual",
            "default": []
          },
          "monthly": {
            "items": {
              "$ref": "#/components/schemas/MonthlyObservation"
            },
            "type": "array",
            "title": "Monthly",
            "default": []
          },
          "comparison": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Comparison"
              },
              {
                "type": "null"
              }
            ]
          },
          "warning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Localized"
              },
              {
                "type": "null"
              }
            ]
          },
          "quality_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Flags",
            "default": []
          },
          "shared_series_with": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shared Series With",
            "default": []
          },
          "requested_coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_cell_center": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_cell_bounds": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Native Cell Bounds"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "publication_state",
          "source"
        ],
        "title": "ClimateComponent"
      },
      "Comparison": {
        "properties": {
          "baseline_period": {
            "type": "string",
            "title": "Baseline Period"
          },
          "recent_period": {
            "type": "string",
            "title": "Recent Period"
          },
          "baseline_value": {
            "type": "number",
            "title": "Baseline Value"
          },
          "recent_value": {
            "type": "number",
            "title": "Recent Value"
          },
          "difference": {
            "type": "number",
            "title": "Difference"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "publication_state": {
            "$ref": "#/components/schemas/PublicationState"
          },
          "method": {
            "type": "string",
            "const": "complete-decade-means",
            "title": "Method",
            "default": "complete-decade-means"
          },
          "review_id": {
            "type": "string",
            "title": "Review Id"
          },
          "explanation": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "type": "object",
        "required": [
          "baseline_period",
          "recent_period",
          "baseline_value",
          "recent_value",
          "difference",
          "unit",
          "publication_state",
          "review_id",
          "explanation"
        ],
        "title": "Comparison"
      },
      "Coordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinates"
      },
      "ExplorationRequest": {
        "properties": {
          "place_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExplorationRequest"
      },
      "ExplorationResponse": {
        "properties": {
          "story": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StoryManifest"
              },
              {
                "type": "null"
              }
            ]
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ExplorationResponse"
      },
      "GlobalContext": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceMetadata"
          },
          "baseline": {
            "type": "string",
            "title": "Baseline"
          },
          "annual": {
            "items": {
              "$ref": "#/components/schemas/AnnualObservation"
            },
            "type": "array",
            "title": "Annual"
          }
        },
        "type": "object",
        "required": [
          "source",
          "baseline",
          "annual"
        ],
        "title": "GlobalContext"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageryAsset": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "thumbnail_url": {
            "type": "string",
            "title": "Thumbnail Url"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "sensor": {
            "type": "string",
            "title": "Sensor"
          },
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "valid_pixel_fraction": {
            "type": "number",
            "title": "Valid Pixel Fraction"
          },
          "scene_cloud_percent": {
            "type": "number",
            "title": "Scene Cloud Percent"
          },
          "alt": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "type": "object",
        "required": [
          "url",
          "thumbnail_url",
          "date",
          "sensor",
          "product_id",
          "source_url",
          "sha256",
          "width",
          "height",
          "bytes",
          "valid_pixel_fraction",
          "scene_cloud_percent",
          "alt"
        ],
        "title": "ImageryAsset"
      },
      "ImageryPair": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "needs_review",
              "approved",
              "unavailable"
            ],
            "title": "Status"
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageryAsset"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageryAsset"
              },
              {
                "type": "null"
              }
            ]
          },
          "bounds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bounds",
            "default": []
          },
          "crs": {
            "type": "string",
            "title": "Crs",
            "default": ""
          },
          "resolution_m": {
            "type": "integer",
            "title": "Resolution M",
            "default": 30
          },
          "attribution": {
            "type": "string",
            "title": "Attribution",
            "default": "USGS/NASA Landsat. Hosted by Microsoft Planetary Computer; processed by My Climate Story."
          },
          "processing_version": {
            "type": "string",
            "title": "Processing Version",
            "default": "landsat-rgb-v1"
          },
          "caption": {
            "$ref": "#/components/schemas/Localized"
          },
