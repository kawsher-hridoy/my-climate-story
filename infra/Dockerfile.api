FROM ghcr.io/astral-sh/uv:0.9.18 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 PATH="/app/.venv/bin:$PATH"
RUN useradd --uid 1000 --create-home app && chown app:app /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY --chown=app:app services services
COPY --chown=app:app pipelines pipelines
RUN uv sync --frozen --no-dev
COPY --chown=app:app content content
COPY --chown=app:app scripts scripts
COPY --chown=app:app data/bootstrap-release.tar.gz data/bootstrap-release.tar.gz
COPY --chown=app:app climate_data.zip My_Climate_Story_NASA_Space_Apps.pdf alembic.ini ./
USER app
EXPOSE 8000
CMD ["sh","scripts/start-api.sh"]
