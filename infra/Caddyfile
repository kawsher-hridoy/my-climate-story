{$SITE_ADDRESS::80} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://gibs.earthdata.nasa.gov; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; frame-ancestors 'none'"
    }
    @hashed path /assets/* /media/*
    header @hashed Cache-Control "public,max-age=31536000,immutable"
    @worker path /sw.js /manifest.webmanifest
    header @worker Cache-Control "no-cache"
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /media/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
